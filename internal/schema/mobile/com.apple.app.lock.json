{
  "title": "Single App Mode",
  "description": "Locks the device to one app, for kiosks and shared devices. Supervised only.",
  "__payloadtype": "com.apple.app.lock",
  "__category": "Security",
  "__multiple": false,
  "__order": 40,
  "options": {
