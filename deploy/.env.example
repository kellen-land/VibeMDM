# Public HTTPS URL devices and browsers use to reach VibeMDM. Must be HTTPS with a
# certificate macOS trusts (Let's Encrypt via the Caddy "tls" profile works well).
VIBEMDM_SERVER_URL=https://mdm.example.com

# Initial password for the "admin" console user (first boot only; 12+ chars,
# placeholders are refused). Leave empty to have one generated: it is printed to
# the container console and saved to /data/initial-admin-password (mode 0600).
# Either way you must change it at first login.
VIBEMDM_ADMIN_PASSWORD=

# Encrypts private keys (SCEP CA, APNs, escrow, profile signing) and FileVault
# recovery keys at rest. Use a long random value and BACK IT UP: without it the
# stored secrets cannot be read and the server refuses to start.
#   openssl rand -base64 48
VIBEMDM_ENCRYPTION_KEY=

# PostgreSQL password (internal to the compose network). Generate one:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Host address/port for the VibeMDM container. Bound to localhost by default so the
# plain-http port is not reachable from the network; the Caddy "tls" profile is the
# public entry point. Set VIBEMDM_BIND=0.0.0.0 only behind your own TLS proxy.
VIBEMDM_BIND=127.0.0.1
VIBEMDM_PORT=8080

# Reverse proxies allowed to set X-Forwarded-For (client IPs for rate limiting
# and audit). The compose network is trusted so Caddy's header is honoured.
VIBEMDM_TRUSTED_PROXIES=172.16.0.0/12

# Labs only: allow a plain http:// server URL (agents would run commands received
# over an unencrypted connection).
# VIBEMDM_ALLOW_HTTP=1

# For `docker compose --profile tls up`:
DOMAIN=mdm.example.com
CADDY_EMAIL=you@example.com

# Optional
VIBEMDM_DEBUG=false
VIBEMDM_LOG_FORMAT=text
