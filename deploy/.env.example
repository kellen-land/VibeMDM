# Public HTTPS URL devices and browsers use to reach VibeMDM. Must be HTTPS with a
# certificate macOS trusts (Let's Encrypt via the Caddy "tls" profile works well).
VIBEMDM_SERVER_URL=https://mdm.example.com

# Initial password for the "admin" console user (first boot only; 8+ chars).
# Leave empty to have one generated and printed in the container log.
VIBEMDM_ADMIN_PASSWORD=change-me-please

# PostgreSQL password (internal to the compose network).
POSTGRES_PASSWORD=change-me-too

# Host port for the VibeMDM container when not using the Caddy profile.
VIBEMDM_PORT=8080

# For `docker compose --profile tls up`:
DOMAIN=mdm.example.com
CADDY_EMAIL=you@example.com

# Optional
VIBEMDM_DEBUG=false
VIBEMDM_LOG_FORMAT=text
